# Copy to .env.local and fill in. Never commit .env.local.

# Admins: comma-separated sign-in emails. They get /admin (learners, courses, stats) and can publish roadmaps to Community.
ADMIN_EMAILS=

# Signs the session cookie. Generate one with: npx auth secret
AUTH_SECRET=

# Google — https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application")
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub — https://github.com/settings/developers (New OAuth App)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# X (Twitter) — https://developer.x.com/en/portal/dashboard (User authentication settings, OAuth 2.0, type "Web App")
# Callback URI: http://localhost:3000/api/auth/callback/twitter
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Neon Postgres — neon.tech → your project → Connect (pooled connection string)
DATABASE_URL=

# YouTube Data API v3 — same Google Cloud project as the OAuth client → APIs & Services → Credentials → API key
YOUTUBE_API_KEY=

# Background jobs. Locally: set INNGEST_DEV=1 and run `pnpm inngest:dev`. On Vercel the Inngest integration sets the keys.
INNGEST_DEV=1

# Supadata — supadata.ai → dashboard → API key. Fetches existing YouTube captions (1 credit per video).
SUPADATA_API_KEY=
# Requests per second your Supadata plan allows (free: 1, Pro: 10). Caption checks are paced to it.
SUPADATA_RPS=1

# Nebius Token Factory — tokenfactory.nebius.com → API keys. Nemotron writes lessons and quizzes.
NEBIUS_API_KEY=

# Tavily — app.tavily.com → API keys. Finds "Further reading" for each lesson while it's written. Optional: without it, lessons have no reading list.
TAVILY_API_KEY=
# Maintenance mode: set to 1 to show a "back soon" page on every route (courses already building still finish).
# Read at build time, so on Vercel redeploy after changing it. Remove it or set 0 to bring the site back.
MAINTENANCE_MODE=

# Pause course builds: set to 1 to stop new courses, retries, and builds already running (no Supadata, Gemini,
# Nemotron, Tavily or Inngest work). Built courses stay usable. On Vercel, redeploy after changing it.
PAUSE_COURSE_BUILDS=

# Dodo Payments — app.dodopayments.com. Plans and limits live in src/lib/plans.ts.
# test_mode while testing; live_mode for real payments (API keys are per mode).
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
# Developer → Webhooks → add endpoint https://<your-domain>/api/webhooks/dodo (all subscription.* events) → copy its secret.
DODO_PAYMENTS_WEBHOOK_KEY=
# Payments stay switched off ("Coming soon", no build limits) until DODO_PAYMENTS_ENVIRONMENT=live_mode.
# Local only: 1 lets you try test-mode checkout here. Ignored in production, so a test card can never buy a plan there.
DODO_ALLOW_TEST_CHECKOUT=
# Products → create 4 subscription products and paste their ids: Pro $19/month, Pro $190/year, Max $59/month, Max $590/year.
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_MAX_MONTHLY=
DODO_PRODUCT_MAX_YEARLY=
# India (₹, GST included) and UK (£, VAT included) prices. Unset → those visitors pay US prices.
DODO_PRODUCT_PRO_MONTHLY_IN=
DODO_PRODUCT_PRO_MONTHLY_GB=
DODO_PRODUCT_PRO_YEARLY_IN=
DODO_PRODUCT_PRO_YEARLY_GB=
DODO_PRODUCT_MAX_MONTHLY_IN=
DODO_PRODUCT_MAX_MONTHLY_GB=
DODO_PRODUCT_MAX_YEARLY_IN=
DODO_PRODUCT_MAX_YEARLY_GB=
# Local only: which country's prices to show (IN, GB or US). Production uses the visitor's real country.
DEV_COUNTRY=

# Chat support for Pro and Max (Support page). WhatsApp: number with country code, digits only. Telegram: username.
# Leave both empty to hide the chat card.
SUPPORT_WHATSAPP=
SUPPORT_TELEGRAM=

# Email (Resend). FROM must be on a domain verified in Resend. APP_URL: where links in emails point.
# Webhook: Resend → Webhooks → https://<domain>/api/webhooks/resend (email.delivered, .bounced, .complained) → signing secret.
EMAIL_FROM=CourseIt <hello@mail.courseit.xyz>
EMAIL_REPLY_TO=hello@triggerfy.xyz
RESEND_WEBHOOK_SECRET=
APP_URL=https://www.courseit.xyz
RESEND_API_KEY=
